# One key pair per parallel testnet bot (separate testnet accounts, so they
# don't compete for the same real/fake balance). Prefix must match what
# each bot's --key-prefix flag expects (see docker-compose.yml).
BINANCE_TESTNET_API_500_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_500_SECRET=your_testnet_api_secret_here

BINANCE_TESTNET_API_10K_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_10K_SECRET=your_testnet_api_secret_here
