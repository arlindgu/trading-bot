# Binance Spot Testnet (testnet.binance.vision) -- shared by all 5 grid bots,
# each still tracks its own self-contained budget slice (see docker-compose.yml).
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Binance USDT-M Futures Demo Trading (demo.binance.com) -- shared by all 10
# coinflip bots (USDT-margined + USDC-margined groups), each tracks its own
# self-contained budget slice.
BINANCE_DEMO_FUTURES_KEY=your_demo_futures_api_key_here
BINANCE_DEMO_FUTURES_SECRET=your_demo_futures_api_secret_here
