# Binance Demo Trading (demo.binance.com) -- one account, used for both spot
# and futures via ccxt's enable_demo_trading(True). Every fleet process
# (spot and futures) and every strategy/budget tier shares this one key,
# each tracking its own self-contained budget slice (see docker-compose.yml
# and config/fleet_*.yaml).
BINANCE_DEMO_KEY=your_demo_api_key_here
BINANCE_DEMO_SECRET=your_demo_api_secret_here
